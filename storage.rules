rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /listings/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /reports/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Photos and videos sent in chat (ChatScreen uploads to chats/{conversationId}/...)
    match /chats/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Photos on reviews: reviews/{reviewerId}/{reviewId}/... Anyone signed in
    // can see them; only the reviewer can add or remove their own.
    match /reviews/{userId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /verifications/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
